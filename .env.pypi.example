# PyPI upload – copy to .env.pypi and set your real token.
# .env.pypi is in .gitignore and will not be committed.
#
# For API token, username is always __token__, not your PyPI account name.
# Create a token at https://pypi.org/manage/account/token/

TWINE_USERNAME=__token__
TWINE_PASSWORD=pypi-your-token-here
